{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/N95Ryan/orbit/main/schema/briefing.schema.json",
  "title": "Orbit briefing",
  "type": "object",
  "required": ["version", "date", "generatedAt", "readingTime", "headlines", "items"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "date": { "type": "string", "format": "date" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "readingTime": { "type": "integer", "minimum": 1, "description": "Minutes" },
    "headlines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "maxLength": 70 }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "kind", "title", "summary", "whyItMatters", "source", "url", "publishedAt"],
        "additionalProperties": false,
        "properties": {
          "topic": {
            "enum": ["go", "rust", "react", "tanstack", "expo", "nextjs", "astro", "supabase", "bun", "cloudflare", "claude"]
          },
          "kind": { "enum": ["release", "breaking", "security", "article"] },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "whyItMatters": { "type": "string" },
          "source": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "publishedAt": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
